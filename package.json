{
  "name": "actis",
  "version": "0.1.0",
  "description": "Local-first activity ledger for your filesystem",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "filesystem",
    "activity",
    "ledger",
    "local-first",
    "changelog"
  ],
  "author": "Ash",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghoulraider13-rgb/Actis.git"
  },
  "scripts": {
    "build": "pnpm --filter=@actis/core --filter=@actis/cli --filter=@actis/site run build",
    "test": "pnpm --filter=@actis/core run test",
    "lint": "pnpm --filter=@actis/core --filter=@actis/cli --filter=@actis/site run lint",
    "dev:cli": "pnpm --filter=@actis/cli run dev",
    "dev:site": "pnpm --filter=@actis/site run dev",
    "cli": "pnpm --filter=@actis/cli run start --",
    "web": "pnpm --filter=@actis/cli run web",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "typescript": "^5.6.0"
  }
}

