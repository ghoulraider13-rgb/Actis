{
  "version": 2,
  "buildCommand": "npm run build",
  "devCommand": "npm run web:dev",
  "installCommand": "npm install",
  "framework": "node",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/public/(.*)",
      "destination": "/public/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/server-vercel.js"
    },
    {
      "source": "/(.*)",
      "destination": "/server-vercel.js"
    }
  ]
}